// Shared helpers for the M4 harness scenarios.
function m4Out() {
    return ($.getenv("DFX_M4_OUT") || "E:/Code/AePlugin_Dynamicfx/scripts/out/m4/dev") + "/";
}
function m4Log(file, s) {
    var f = new File(m4Out() + file);
    f.encoding = "UTF-8";
    if (f.open("a")) { f.write(s + "\n"); f.close(); }
}
function m4FindComp() {
    for (var j = 1; j <= app.project.numItems; j++) {
        if (app.project.item(j) instanceof CompItem && app.project.item(j).name === "m4") {
            return app.project.item(j);
        }
    }
    return null;
}
function m4Fx() {
    return m4FindComp().layer(1).property("ADBE Effect Parade").property(1);
}
function m4GenPass() {
    return "#version 450\n" +
        "layout(location = 0) in vec2 v_uv;\n" +
        "layout(location = 0) out vec4 outColor;\n" +
        "// @param gain min:0 max:1 default:0.5\n" +
        "layout(set = 0, binding = 2) uniform FxUniforms {\n" +
        "    vec2 u_resolution;\n" +
        "    float u_time;\n" +
        "    float u_frame;\n" +
        "    float gain;\n" +
        "};\n" +
        "void main() { outColor = vec4(v_uv * gain, 0.0, 1.0); }\n";
}
function m4InvertPass() {
    return "#version 450\n" +
        "layout(location = 0) in vec2 v_uv;\n" +
        "layout(location = 0) out vec4 outColor;\n" +
        "layout(set = 0, binding = 0) uniform texture2D u_input;\n" +
        "layout(set = 0, binding = 1) uniform sampler u_sampler;\n" +
        "layout(set = 0, binding = 2) uniform FxUniforms {\n" +
        "    vec2 u_resolution;\n" +
        "    float u_time;\n" +
        "    float u_frame;\n" +
        "};\n" +
        "void main() {\n" +
        "    vec4 c = texture(sampler2D(u_input, u_sampler), v_uv);\n" +
        "    outColor = vec4(1.0 - c.rgb, 1.0);\n" +
        "}\n";
}
function m4TwoPassEnvelope() {
    return "@dynamicfx 1\n@graph\npass gen: input -> mid\npass inv: mid -> output\n@end\n" +
        "@pass gen\n" + m4GenPass() + "@endpass\n" +
        "@pass inv\n" + m4InvertPass() + "@endpass\n";
}
